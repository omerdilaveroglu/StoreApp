@model ProductListViewModel

<h5>Index Page</h5>


@if (!Model.Products.Any())
{
    <p>No products found.</p>
}
else
{
    @foreach (var p in Model.Products){
    <div>
        <h4>@p.Name</h4>
        <p>@p.Description</p>
        <p>Price: @p.Price</p>
        <p>Category: @p.Category</p>
    </div>
}
}



